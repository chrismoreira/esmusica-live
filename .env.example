# =============================================================================
# Músicos:Bandas — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# =============================================================================

# Database (Neon or Supabase PostgreSQL)
# Use a connection pooler URL (PgBouncer) for DATABASE_URL on serverless
DATABASE_URL="postgresql://user:password@host:5432/musicos_bandas?pgbouncer=true&connection_limit=1"
# Direct (non-pooled) URL — used by Prisma CLI for migrations
DIRECT_URL="postgresql://user:password@host:5432/musicos_bandas"

# Auth.js v5
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (transactional email)
# https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@musicos-bandas.com"

# Wompi payments (El Salvador)
# https://wompi.com/en/developers
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_WEBHOOK_SECRET=""
WOMPI_EVENTS_KEY=""

# Cloudflare Stream (video uploads/playback)
# https://dash.cloudflare.com/ → Stream
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""

# Cloudflare R2 (photo storage)
# https://dash.cloudflare.com/ → R2
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="musicos-bandas"
CLOUDFLARE_R2_PUBLIC_URL=""

# Prisma Accelerate (optional — connection pooling optimized for Vercel serverless)
# After setup at https://console.prisma.io, replace DATABASE_URL with the Accelerate URL
# PRISMA_ACCELERATE_URL=""
