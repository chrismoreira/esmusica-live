# =============================================================================
# esmusica.live — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# =============================================================================

# ─── Database (MySQL) ────────────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Local development:
# DATABASE_URL="mysql://root:password@localhost:3306/esmusica"
#
# Shared hosting (cPanel / Plesk):
# DATABASE_URL="mysql://esmusica_user:password@localhost:3306/esmusica_db"
#
# Cloud (Aiven, Railway, PlanetScale, etc.):
# DATABASE_URL="mysql://user:password@mysql-host.example.com:3306/esmusica?ssl=true"
DATABASE_URL="mysql://user:password@localhost:3306/esmusica"

# ─── Auth.js v5 ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3001"

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Resend (transactional email) ────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@esmusica.live"

# ─── Wompi (payments — El Salvador) ─────────────────────────────────────────
# https://wompi.com/en/developers
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_WEBHOOK_SECRET=""
WOMPI_EVENTS_KEY=""

# ─── Cloudflare Stream (video uploads/playback) ──────────────────────────────
# https://dash.cloudflare.com/ → Stream
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""

# ─── Cloudflare R2 (photo storage) ──────────────────────────────────────────
# https://dash.cloudflare.com/ → R2
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="esmusica-photos"
CLOUDFLARE_R2_PUBLIC_URL=""
